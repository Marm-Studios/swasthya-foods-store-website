{%- liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'

  if section.settings.image_behavior == 'ambient'
    assign full_width = '120vw'
    assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
  endif
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div class="page-width">
  <h2 class="title h2">{{ section.settings.heading }}</h2>
  <div class="product-benefits-container_ct page-width">
    <div>
      {% if section.settings.product_benefits_image != blank %}
        {%- assign img = section.settings.product_benefits_image -%}
        {% comment %}
          <img
            src="{{ img | image_url }}"
            {% comment %} srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1200 }} 1200w" {% endcomment %}
            {% comment %} sizes="(max-width: 640px) 100vw, 50vw" {% endcomment %}
            alt="{{ section.settings.product_image_alt_text | escape }}"
            loading="{% if section.settings.lazyload %}lazy{% else %}eager{% endif %}"
            {% comment %} class="w-full h-auto object-cover rounded" {% endcomment %}
            height="auto"
            width="auto"
          >
        {% endcomment %}
        {%- liquid
          assign img = section.settings.product_benefits_image
          assign image_height = img.width | divided_by: img.aspect_ratio

          assign sizes = full_width
        -%}
        {{
          section.settings.product_benefits_image
          | image_url: width: 3840
          | image_tag:
            width: img.width,
            height: image_height,
            class: '',
            sizes: sizes,
            widths: widths,
            fetchpriority: fetch_priority
        }}
      {% endif %}
    </div>
    <div class="product-benefits-icon-container_ct">
      <div class="product-benefits-content-block_ct">
        <div class="product-benefits-icon-wrapper_ct">
          <span class="svg-wrapper product-benefits-icon_ct">{{ 'icon-diabetes.svg' | inline_asset_content }}</span>
        </div>
        <p>Ideal for diabetes</p>
      </div>
      <div class="product-benefits-content-block_ct">
        <div class="product-benefits-icon-wrapper_ct">
          <span class="svg-wrapper product-benefits-icon_ct">{{ 'icon-lowgi.svg' | inline_asset_content }}</span>
        </div>
        <p>Low Glycemic Index</p>
      </div>
      <div class="product-benefits-content-block_ct">
        <div class="product-benefits-icon-wrapper_ct">
          <span class="svg-wrapper product-benefits-icon_ct">{{ 'icon-weight.svg' | inline_asset_content }}</span>
        </div>
        <p>Helps Manage Weight</p>
      </div>
      <div class="product-benefits-content-block_ct">
        <div class="product-benefits-icon-wrapper_ct">
          <span class="svg-wrapper product-benefits-icon_ct">{{ 'icon-fiber.svg' | inline_asset_content }}</span>
        </div>
        <p>High In Fiber</p>
      </div>
    </div>
  </div>
  {% comment %} <hr class="line-separator_ct"> {% endcomment %}
</div>

{% schema %}
{
  "name": "Product benefits (custom)",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Swasthya Difference"
    },
    {
      "type": "image_picker",
      "id": "product_benefits_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "product_image_alt_text",
      "label": "Image alt text",
      "default": "Image showcasing difference between Swasthya Foods products and others"
    },
    {
      "type": "checkbox",
      "id": "lazyload",
      "label": "Lazy-load image",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Product benefits (custom)",
      "category": "Home"
    }
  ]
}
{% endschema %}
